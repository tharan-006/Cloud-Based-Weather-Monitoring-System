# ===================================================
# Cloud-Based Weather Monitoring System - Environment Configuration
# ===================================================

# OpenWeatherMap API Key
# 1. Sign up for free at https://openweathermap.org/
# 2. Go to your API keys section (https://home.openweathermap.org/api_keys)
# 3. Generate a free API key and paste it below:
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5050
SECRET_KEY=cloud-weather-monitoring-secret-key-2026

# Database Configuration
DATABASE_PATH=weather_history.db
